# Family Dashboard Voice konfiguration (Linux Voice Assistant).
# Linjer startende med # ignoreres af systemd; fjern # for at aktivere.
# Se https://github.com/OHF-Voice/linux-voice-assistant for alle muligheder.

# Synligt navn på enheden i Home Assistant.
CLIENT_NAME=Family Dashboard Voice

# Lyt på alle netværksinterfacer, så Home Assistant kan nå enheden på port 6053.
HOST=0.0.0.0
PORT=6053

# Surface Pro 4's indbyggede mikrofon er en 16 kHz singlechannel-mic.
AUDIO_INPUT_CHANNELS=1

# Støjreduktion/forstærkning via WebRTC.
# MIC_NOISE_SUPPRESSION=1
# MIC_AUTO_GAIN=0

# Wake word og stop-ord (udskiftes ændres uden genstart fra HA-device-siden).
# WAKE_MODEL=okay_nabu
# STOP_MODEL=stop

# Sæt når HA ikke finder enheden via mDNS/ESPHome i samme netværk:
# NETWORK_INTERFACE=wlan0
# AUDIO_INPUT_DEVICE=default
# AUDIO_OUTPUT_DEVICE=default

# Ekstra funktioner:
# ENABLE_THINKING_SOUND=1
# ENABLE_DEBUG=1